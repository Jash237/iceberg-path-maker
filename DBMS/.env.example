# MicroLend OLTP Database Configuration
# Provide your MySQL connection credentials below.
# If MySQL is not running or unreachable, MicroLend automatically utilizes
# its built-in high-performance OLTP in-memory storage engine with ACID guarantees!

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=microlend_db

# Application Configuration
NEXT_PUBLIC_APP_NAME="MicroLend OLTP"
NEXT_PUBLIC_APP_TAGLINE="Secure Micro-Lending & EMI Management System"
